# ─── Banavoo Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/banavoo

# JWT — use a long, random string in production
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=30d

# Frontend URL (used in password reset links)
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Resend (email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
# "From" address shown to recipients (must be a verified Resend domain)
EMAIL_FROM=Banavoo <noreply@banavoo.in>

# ── Cloudinary (image uploads — logo, banner, favicon) ───────────────────────
# Required for Step 3 image upload endpoints.
# Sign up at https://cloudinary.com — free tier is sufficient for development.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
