# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/dormitory_management

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=STHALS.IN
SMTP_FROM_EMAIL=noreply@sthals.in
FRONTEND_URL=https://www.sthals.in

# SMS Configuration (for future implementation)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id

# Razorpay Configuration (for online payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS Configuration (for future implementation)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id