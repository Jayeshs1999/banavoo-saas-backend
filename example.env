# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local dev: mongodb://localhost:27017/dormitory_management
# For Atlas:     mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/dormitory_management?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/dormitory_management

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration — Resend (https://resend.com)
# Sign up at resend.com, create an API key, and paste it below
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FRONTEND_URL=https://www.bedwale.in

# SMS Configuration (for future implementation)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id

# Razorpay Configuration (for online payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS Configuration (for future implementation)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id